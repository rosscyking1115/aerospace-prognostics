# Example environment for the FastAPI service and Streamlit console.
# Copy to `.env` and fill in real values locally. Never commit `.env`.
# All values below are placeholders — not real secrets.

# --- FastAPI inference service ---
# Path to the packaged model artifact the service loads.
AEROSPACE_PROGNOSTICS_MODEL_PATH=artifacts/quickstart_cmapss/model
# Optional expected artifact SHA (integrity check at load).
AEROSPACE_PROGNOSTICS_MODEL_SHA=
# API key required on requests (leave empty to disable auth locally).
AEROSPACE_PROGNOSTICS_API_KEY=
# Per-client request budget; 0 disables rate limiting.
AEROSPACE_PROGNOSTICS_RATE_LIMIT_PER_MINUTE=60

# --- Streamlit console ---
# Base URL the console uses to reach the API.
AEROSPACE_PROGNOSTICS_API_BASE_URL=http://127.0.0.1:8000
# Token gating access to the hosted read-only console (demo only).
AEROSPACE_PROGNOSTICS_CONSOLE_ACCESS_TOKEN=
# Keep the console read-only (recommended for shared/hosted use).
AEROSPACE_PROGNOSTICS_CONSOLE_READ_ONLY=true

# --- Healthcheck (container) ---
AEROSPACE_PROGNOSTICS_HEALTHCHECK_URL=http://127.0.0.1:8000/health
AEROSPACE_PROGNOSTICS_HEALTHCHECK_TIMEOUT_SECONDS=2
